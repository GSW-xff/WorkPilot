{
  "title": "WorkPilot Reliability and Cost",
  "uid": "workpilot-v3",
  "schemaVersion": 40,
  "refresh": "5s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Task duration",
      "targets": [{"expr": "rate(task_duration_seconds_sum[5m]) / rate(task_duration_seconds_count[5m])", "legendFormat": "{{status}}"}],
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tool errors and dedup hits",
      "targets": [
        {"expr": "rate(tool_error_total[5m])", "legendFormat": "errors {{capability}}"},
        {"expr": "rate(tool_duplicate_total[5m])", "legendFormat": "duplicates {{capability}}"}
      ],
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Model token usage",
      "targets": [{"expr": "rate(model_token_usage_total[5m])", "legendFormat": "{{model}} {{direction}}"}],
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Estimated model cost (USD)",
      "targets": [{"expr": "sum(model_cost_usd_total)", "legendFormat": "cost"}],
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API P95 latency",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_duration_seconds_bucket{route!~\"/metrics|/v1/evaluations/run\"}[5m])))", "legendFormat": "P95"}],
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Request trace completeness",
      "targets": [{"expr": "sum(rate(api_request_trace_total[10m])) / clamp_min(sum(rate(api_request_total[10m])), 0.001)", "legendFormat": "ratio"}],
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}
    }
  ]
}
