# Minimal local demo (no external services required)
WORKPILOT_HOST=127.0.0.1
WORKPILOT_PORT=8000
WORKPILOT_MAX_STEPS=20
WORKPILOT_AUTO_CREATE_SCHEMA=false
WORKPILOT_ALLOWED_RECIPIENT_DOMAINS=example.com
WORKPILOT_PLANNER_MODE=demo

# Optional persistent database. Uncomment both lines when PostgreSQL is running.
# WORKPILOT_DATABASE_URL=postgresql+psycopg://workpilot_app:workpilot_app@127.0.0.1:5432/workpilot
# WORKPILOT_MIGRATION_DATABASE_URL=postgresql+psycopg://workpilot_owner:workpilot_owner@127.0.0.1:5432/workpilot

# Optional Temporal workflow engine.
# WORKPILOT_TEMPORAL_TARGET=127.0.0.1:7233
WORKPILOT_TEMPORAL_TASK_QUEUE=workpilot-tasks

# Optional OpenAI-compatible planner. Set PLANNER_MODE=openai only after adding a key.
WORKPILOT_MODEL_BASE_URL=https://api.openai.com/v1
WORKPILOT_MODEL_NAME=gpt-4.1-mini
WORKPILOT_MODEL_API_KEY=
WORKPILOT_MODEL_INPUT_BUDGET=8000
WORKPILOT_MODEL_OUTPUT_BUDGET=2000
WORKPILOT_MODEL_COST_BUDGET_USD=0.25
WORKPILOT_PRIMARY_MODEL_API_KEY=
WORKPILOT_ECONOMY_MODEL_API_KEY=

# Optional GitHub connector and disposable sandbox.
WORKPILOT_GITHUB_CLIENT_ID=
WORKPILOT_GITHUB_CLIENT_SECRET=
WORKPILOT_GITHUB_STATE_SECRET=
WORKPILOT_GITHUB_REDIRECT_URI=http://127.0.0.1:8000/v1/connectors/github/callback
WORKPILOT_GITHUB_WEBHOOK_SECRET=
WORKPILOT_GITHUB_SANDBOX_TOKEN=
WORKPILOT_GITHUB_SANDBOX_REPO=owner/disposable-repository

# Authentication defaults to trusted local headers. Configure OIDC together.
WORKPILOT_AUTH_MODE=headers
WORKPILOT_OIDC_ISSUER=
WORKPILOT_OIDC_AUDIENCE=
WORKPILOT_OIDC_JWKS_URL=

# Local knowledge objects and optional telemetry.
WORKPILOT_KNOWLEDGE_OBJECT_DIR=/tmp/workpilot-objects
WORKPILOT_KNOWLEDGE_MAX_FILE_BYTES=10485760
WORKPILOT_OTLP_ENDPOINT=
WORKPILOT_SERVICE_NAME=workpilot-api
